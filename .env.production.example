# ─────────────────────────────────────────────────────────────
# osonNavbat — PRODUCTION (qulaynavbat.uz)
#
#   cp .env.production.example .env
#   ↓ va quyidagi 5 ta joyni to'ldiring:
#     1. DJANGO_SECRET_KEY   2. POSTGRES_PASSWORD/DATABASE_URL
#     3. SMS provayder kaliti 4. GOOGLE_CLIENT_ID  5. DJANGO_ADMIN_URL
#
# ⚠️ Bu faylni hech qachon git'ga qo'shmang.
# ─────────────────────────────────────────────────────────────

# ── Django ───────────────────────────────────────────────────
# MAJBURIY: yangi kalit yarating (kamida 50 belgi), aks holda server ko'tarilmaydi:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# Bu kalit JWT tokenlarni ham imzolaydi — sizib chiqsa, istalgan akkauntga
# (super admin ham) token yasab kirish mumkin bo'ladi.
DJANGO_SECRET_KEY=

DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=api.qulaynavbat.uz
DJANGO_TIME_ZONE=Asia/Tashkent

# ── Baza ─────────────────────────────────────────────────────
# Parolni albatta o'zgartiring (docker-compose.prod.yml ham shuni o'qiydi).
POSTGRES_DB=osonnavbat
POSTGRES_USER=osonnavbat
POSTGRES_PASSWORD=
DATABASE_URL=postgres://osonnavbat:PAROLNI-SHU-YERGA@db:5432/osonnavbat
DB_CONN_MAX_AGE=60

# ── Redis ────────────────────────────────────────────────────
# MAJBURIY: throttling (OTP brute-force himoyasi) shu yerda hisoblanadi.
# Bo'sh qolsa har bir gunicorn worker'i alohida sanaydi va limit kuchsizlanadi.
REDIS_URL=redis://redis:6379/0

# ── CORS / CSRF ──────────────────────────────────────────────
# Frontend qaysi manzillardan API'ga murojaat qiladi.
# `www` bilan ham ochilsa — ikkalasini ham yozing, ular ALOHIDA origin.
CORS_ALLOWED_ORIGINS=https://qulaynavbat.uz,https://www.qulaynavbat.uz
CSRF_TRUSTED_ORIGINS=https://qulaynavbat.uz,https://www.qulaynavbat.uz,https://api.qulaynavbat.uz
FRONTEND_URL=https://qulaynavbat.uz
# Vercel preview deploylar kerak bo'lsa:
# CORS_ALLOWED_ORIGIN_REGEXES=^https://.*\.vercel\.app$

# ── Auth cookie ──────────────────────────────────────────────
# qulaynavbat.uz va api.qulaynavbat.uz — bitta "site" (eTLD+1 bir xil), shuning uchun
# SameSite=Lax yetarli VA SameSite=None dan xavfsizroq (CSRF yuzasi kichikroq).
# Faqat frontend boshqa domenda tursa (masalan *.vercel.app) — None qiling.
AUTH_COOKIE_SECURE=True
AUTH_COOKIE_SAMESITE=Lax
AUTH_COOKIE_DOMAIN=.qulaynavbat.uz
ACCESS_TOKEN_LIFETIME_MINUTES=30
REFRESH_TOKEN_LIFETIME_DAYS=30

SECURE_SSL_REDIRECT=True

# ── Kirish usuli ─────────────────────────────────────────────
# Ro'yxatdan o'tish FAQAT Google orqali. Telefon + SMS o'chirilgan:
# `/auth/otp/*` manzillari umuman ro'yxatga olinmaydi (404).
#
# ⚠️ Bu holatda GOOGLE_CLIENT_ID to'ldirilishi SHART, aks holda hech kim
#    tizimga kira olmaydi va server ataylab ishga tushmaydi.
#
# Keyinchalik SMS kerak bo'lsa (masalan Google akkaunti yo'q ustalar uchun) —
# `True` qiling va SMS provayder kalitlarini to'ldiring. Kod joyida turibdi.
AUTH_SMS_ENABLED=False

# ── SMS / OTP (AUTH_SMS_ENABLED=True bo'lgandagina ishlatiladi) ──────────
# console EMAS! Haqiqiy provayder tanlang: eskiz | playmobile
SMS_BACKEND=eskiz
OTP_LENGTH=4
OTP_TTL_SECONDS=120
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# ⚠️ Ikkalasi ham prodda o'chirilgan bo'lishi SHART.
# OTP_TEST_PHONES bo'sh bo'lmasa — server ataylab ishga tushmaydi.
OTP_RETURN_IN_RESPONSE=False
OTP_TEST_PHONES=

ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_FROM=4546
ESKIZ_BASE_URL=https://notify.eskiz.uz/api

PLAYMOBILE_LOGIN=
PLAYMOBILE_PASSWORD=
PLAYMOBILE_FROM=3700
PLAYMOBILE_BASE_URL=http://91.204.239.44/broker-api

# ── Google OAuth ─────────────────────────────────────────────
# ⚠️ MAJBURIY (AUTH_SMS_ENABLED=False bo'lgani uchun) — bu yagona kirish yo'li.
#
# Olish tartibi (console.cloud.google.com):
#   1. Loyiha yarating (yoki mavjudini tanlang)
#   2. APIs & Services -> OAuth consent screen -> External -> to'ldiring
#   3. APIs & Services -> Credentials -> Create Credentials
#      -> OAuth client ID -> Application type: Web application
#   4. Authorized JavaScript origins:
#        https://qulaynavbat.uz
#        https://www.qulaynavbat.uz
#   5. Chiqqan "Client ID" (…apps.googleusercontent.com) ni shu yerga qo'ying.
#      "Client secret" backendga KERAK EMAS — biz faqat id_token tekshiramiz.
GOOGLE_CLIENT_ID=

# ── Web Push (brauzer bildirishnomalari) ─────────────────────
# Kalitlarni bir marta yarating:
#   docker compose -f docker-compose.prod.yml exec api python manage.py generate_vapid_keys
# ⚠️ Keyinchalik ALMASHTIRMANG — almashtirsangiz mavjud barcha obunalar
#    yaroqsiz bo'lib qoladi va foydalanuvchilar qayta "Ruxsat berish" bosishi kerak.
# Bo'sh qoldirsangiz push o'chadi, sayt ichidagi qo'ng'iroqcha esa baribir ishlaydi.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@qulaynavbat.uz
PUSH_TIMEOUT_SECONDS=10

# ── Fayl saqlash ─────────────────────────────────────────────
STORAGE_BACKEND=local
# Nginx `/media/` ni to'g'ridan-to'g'ri beradi (docker-compose.prod.yml shunday),
# shuning uchun Django'ni bezovta qilmaymiz.
SERVE_MEDIA=False
MAX_UPLOAD_SIZE=5242880

# ── Limitlar ─────────────────────────────────────────────────
THROTTLE_ANON=120/min
THROTTLE_USER=300/min
THROTTLE_OTP_REQUEST=5/hour
THROTTLE_OTP_VERIFY=15/hour
THROTTLE_BOOKING_CREATE=30/hour
# Nginx orqasida turibmiz — 1. Bu bo'lmasa OTP limitini header bilan aylanib o'tish mumkin.
NUM_PROXIES=1

# ── Admin / hujjatlar ────────────────────────────────────────
# `/admin/` da qoldirmang — botlar aynan shu manzilga parol tanlaydi.
DJANGO_ADMIN_URL=boshqaruv-7f3a/
# Swagger'ni prodda faqat staff ko'radi; umuman kerak bo'lmasa False qiling.
ENABLE_API_DOCS=False

# ── Biznes qoidalari ─────────────────────────────────────────
BOOKING_CANCEL_WINDOW_MINUTES=60
BOOKING_MAX_DAYS_AHEAD=30
BOOKING_MAX_ACTIVE_PER_CLIENT=5
