# ─────────────────────────────────────────────────────────────
# osonNavbat backend — LOKAL ishlab chiqish uchun
# Nusxa oling:  cp .env.example .env
# Serverga joylash uchun:  .env.production.example ga qarang
# ─────────────────────────────────────────────────────────────

# Django
DJANGO_SECRET_KEY=change-me-in-production-please-use-50-random-chars
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=Asia/Tashkent

# Database (docker-compose ichida host = db)
DATABASE_URL=postgres://osonnavbat:osonnavbat@db:5432/osonnavbat
# Lokal (Docker'siz) ishlatish uchun:
# DATABASE_URL=sqlite:///db.sqlite3

# Redis (cache + throttling)
REDIS_URL=redis://redis:6379/0

# CORS / CSRF — Next.js frontend manzillari
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# ── Auth cookie sozlamalari ──────────────────────────────────
AUTH_COOKIE_SECURE=False
AUTH_COOKIE_SAMESITE=Lax
AUTH_COOKIE_DOMAIN=
ACCESS_TOKEN_LIFETIME_MINUTES=30
REFRESH_TOKEN_LIFETIME_DAYS=30

# ── SMS / OTP ────────────────────────────────────────────────
# Variantlar: console | eskiz | playmobile
SMS_BACKEND=console
OTP_LENGTH=4
OTP_TTL_SECONDS=120
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
# DEBUG=True bo'lganda OTP kodi API javobida qaytariladi (front test qilishi uchun)
OTP_RETURN_IN_RESPONSE=True
# ⚠️ Test raqamlari FAQAT DEBUG=True da ishlaydi va prodda bo'sh bo'lishi SHART
#    (aks holda server ishga tushmaydi — bu ataylab shunday).
OTP_TEST_PHONES=+998901234567,+998900000000
OTP_DEBUG_CODE=0000

# Eskiz.uz
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_FROM=4546
ESKIZ_BASE_URL=https://notify.eskiz.uz/api

# Play Mobile (playmobile.uz)
PLAYMOBILE_LOGIN=
PLAYMOBILE_PASSWORD=
PLAYMOBILE_FROM=3700
PLAYMOBILE_BASE_URL=http://91.204.239.44/broker-api

# ── Google OAuth ─────────────────────────────────────────────
GOOGLE_CLIENT_ID=

# ── Web Push ─────────────────────────────────────────────────
# python manage.py generate_vapid_keys
# Bo'sh bo'lsa push o'chadi (sayt ichidagi xabarlar ishlayveradi).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@qulaynavbat.uz

# ── Fayl saqlash ─────────────────────────────────────────────
# local | s3
STORAGE_BACKEND=local
# Media'ni Django o'zi bersinmi (nginx bersa — False)
SERVE_MEDIA=True
# Rasm uchun maksimal hajm (bayt), default 5 MB
MAX_UPLOAD_SIZE=5242880
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=
AWS_S3_REGION_NAME=us-east-1
AWS_S3_CUSTOM_DOMAIN=

# ── Limitlar (throttling) ────────────────────────────────────
THROTTLE_ANON=120/min
THROTTLE_USER=300/min
THROTTLE_OTP_REQUEST=5/hour
THROTTLE_OTP_VERIFY=15/hour
THROTTLE_BOOKING_CREATE=30/hour
# Nginx orqasida 1, to'g'ridan-to'g'ri ishlasa 0
NUM_PROXIES=0

# ── Admin / hujjatlar ────────────────────────────────────────
DJANGO_ADMIN_URL=admin/
ENABLE_API_DOCS=True

# ── Biznes qoidalari ─────────────────────────────────────────
# Mijoz bronni boshlanishiga necha daqiqa qolganda ham bekor qila oladi
BOOKING_CANCEL_WINDOW_MINUTES=60
# Necha kun oldinga bron qilishga ruxsat
BOOKING_MAX_DAYS_AHEAD=30
# Bir mijozda bir vaqtning o'zida nechta faol bron bo'lishi mumkin
BOOKING_MAX_ACTIVE_PER_CLIENT=5
